# .clang-format - Engine2D (C++20 / SFML 3)
# Allman braces, real tabs, Unreal-style naming. Tuned so hand-formatted math
# (matrix / vector expressions and aligned trailing comments) is preserved rather
# than reflowed by the formatter.

Language: Cpp
Standard: c++20
BasedOnStyle: Microsoft

# --- Indentation: real tabs, width 4 ---
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: All
IndentPPDirectives: BeforeHash
IndentCaseLabels: true
IndentCaseBlocks: false

# --- Line width: wide, so long matrix/vector formulas are not split mid-expression ---
ColumnLimit: 200
# Drop break penalties so the formatter trusts your manual line breaks instead of fighting them.
PenaltyBreakAssignment: 0
PenaltyBreakBeforeFirstCallParameter: 0
PenaltyBreakOpenParenthesis: 0
PenaltyIndentedWhitespace: 0

# --- Braces: Allman (every brace on its own line) ---
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: true
  IndentBraces: false

# --- Pointers / references bind to the type: FVector2D* Foo ---
PointerAlignment: Left

# --- Constructor initializer list: leading comma  ( ": A" / ", B" ) ---
BreakConstructorInitializers: BeforeComma
BreakInheritanceList: AfterColon
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
Cpp11BracedListStyle: false   # keep spaces inside braced lists: { 0.0f, 0.0f }

# --- Alignment ---
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignEscapedNewlines: Left
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1
SpacesBeforeTrailingComments: 2

# --- Short constructs ---
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline   # one-line getters inside classes stay on one line
AllowShortLambdasOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never

# --- Includes: keep the manual order (system <> first, then "" grouped by hand) ---
SortIncludes: Never

# --- Empty lines ---
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: true
EmptyLineBeforeAccessModifier: LogicalBlock
InsertNewlineAtEOF: true

# --- Treat Unreal-style macros as statements (no stray indentation / phantom semicolons) ---
StatementMacros:
  - UPROPERTY
  - UFUNCTION
  - UCLASS
  - USTRUCT
  - UENUM
  - UINTERFACE
  - GENERATED_BODY
